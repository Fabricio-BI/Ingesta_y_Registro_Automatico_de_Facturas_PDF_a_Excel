# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copia este archivo como `.env` (mismo nombre, sin ".example") en la raiz
# del proyecto y completa los valores reales. El archivo `.env` esta
# incluido en `.gitignore` y NUNCA debe subirse al repositorio.
# ---------------------------------------------------------------------------

# Clave de la API de Google AI Studio (Gemini).
# Obtener en: https://aistudio.google.com/app/apikey
# Sin esta clave, las facturas de proveedores no registrados en el catalogo
# quedaran marcadas como "sin plantilla" en el reporte.
GEMINI_API_KEY=tu_api_key_aqui
